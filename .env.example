SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///autocloud.db
GEMINI_API_KEY=
SESSION_COOKIE_SECURE=false

# Optional: set all three values to create the first admin account.
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Required by Docker Compose for PostgreSQL.
POSTGRES_DB=autocloud
POSTGRES_USER=autocloud
POSTGRES_PASSWORD=replace-with-a-long-random-value

